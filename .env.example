# Copy to .env and replace every value. Generate passwords with:
#   openssl rand -hex 16
SOURCE_PASSWORD=change-me
DEBEZIUM_PASSWORD=change-me
CATALOG_PASSWORD=change-me
MINIO_USER=lakehouse
MINIO_PASSWORD=change-me-at-least-8-chars
AIRFLOW_ADMIN_PASSWORD=change-me

# Your user id on the host (`id -u`), so Airflow can write ./dashboard.
AIRFLOW_UID=1000

# Real seconds between simulator ticks. One tick is five simulated minutes.
TICK_SLEEP=3
